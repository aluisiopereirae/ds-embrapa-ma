' ║  C4 LEVEL 3b — MAPA INTERATIVO                                     ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L3b_Mapa
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #0d1a0d
skinparam defaultFontColor #d4f0d4
skinparam arrowColor #4ade80
skinparam arrowFontColor #86efac
skinparam componentBackgroundColor #1f3320
skinparam componentBorderColor #3a6a3a
skinparam componentFontColor #e8f5e8
skinparam packageBackgroundColor #0f1a0f
skinparam packageBorderColor #2a5a2a
skinparam packageFontColor #86efac
skinparam cloudBackgroundColor #1a1a2e
skinparam cloudBorderColor #6060a0
skinparam cloudFontColor #c0c0e0

title "DS Embrapa MA — C4 Level 3b: Modulo Mapa Interativo"

cloud "Esri ArcGIS Online\n(World Imagery)" as ESRI
cloud "OpenStreetMap\n(camada normal)" as OSM

package "Modulo Mapa (#view-map)" {

  component "MapController\nshowView('map')\ninitMap() — L.map\nsetMapLayer(type)" as MAP_CTRL

  component "LayerManager\nnormal (OSM)\nsatellite (Esri)\nhybrid (Esri + Labels)" as LAYER

  component "MapToolbar\nCamadas: Normal / Satelite / Hibrido\nBotoes: Sistemas / Heatmaps" as TOOLBAR

  package "Painel de Sistemas Produtivos" {
    component "SistemaToggleButtons\nILP/ILPF / SAF / Apicultura\nMeliponicultura / Sisteminha\nPiscicultura / Extrativismo\nFruticultura / Roca" as SYS_BTN
    component "SistemaLayerRenderer\ntoggleSysLayer(sysKey)\nL.circleMarker colorizado\npor sistema produtivo" as SYS_LAYER
    component "SistemaPopup\nmunicípio, produtor, area,\nsistema, ano, carbono, renda" as SYS_POP
    component "SistemaFilterChips\nfiltros rapidos na sidebar" as SYS_CHIPS
  }

  package "Painel de Heatmaps" {
    component "HeatmapToggleButtons\nGEE / Desmatamento\nPopulacao / Renda\nQueimadas / IDH" as HM_BTN
    component "HeatmapRenderer\nL.heatLayer com MUNIC_DATA\nnormalizado por variavel" as HM_RENDER
  }

  component "FilterSidebar\nSistema, Mesorregiao,\nBioma, Escala, Status,\nAno de implantacao" as FSIDEBAR

  component "MapPoints (URTs)\nL.circleMarker por URT\nColorizado por sistema\nClicavel -> popup" as MAP_PTS

  component "RefCaseButtons\nshowRefCase(key)\nFoca no mapa + popup\ndo caso de referencia" as REF_BTN

  component "DownloadMapImage\nhtml2canvas\nPNG / JPG do mapa" as DL_MAP

  component "L.map (instancia Leaflet)\nL.tileLayer (base)\nL.layerGroup (URTs)\nL.heatLayer (heatmaps)\nL.popup (detalhes)" as LEAFLET
}

MAP_CTRL --> LAYER    : "setMapLayer()"
MAP_CTRL --> MAP_PTS  : "renderMapPoints()"
SYS_BTN  --> SYS_LAYER : "toggleSysLayer()"
HM_BTN   --> HM_RENDER : "showHeatmap()"
SYS_LAYER --> LEAFLET  : "addTo / removeFrom"
HM_RENDER --> LEAFLET  : "addTo / removeFrom"
MAP_PTS  --> SYS_POP   : "on('click')"
LAYER    --> ESRI      : "tiles satelite/hibrido\nHTTPS"
LAYER    --> OSM       : "tiles normal\nHTTPS"
FSIDEBAR --> MAP_PTS   : "filtra e re-renderiza"
@enduml


' ╔══════════════════════════════════════════════════════════════════════╗
' ║  C4 LEVEL 3c — PROJECOES GEE 2025-2050 + ANALISE COMPARATIVA      ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L3c_Projecoes_GEE
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #0d1a0d
skinparam defaultFontColor #d4f0d4
skinparam arrowColor #4ade80
skinparam arrowFontColor #86efac
skinparam componentBackgroundColor #1f3320
skinparam componentBorderColor #3a6a3a
skinparam componentFontColor #e8f5e8
skinparam packageBackgroundColor #0f1a0f
skinparam packageBorderColor #2a5a2a
skinparam packageFontColor #86efac

title "DS Embrapa MA — C4 Level 3c: Projecoes GEE 2025-2050 e Analise Comparativa Municipal"

package "Modulo Projecoes (#view-proj)" {

  component "ProjecoesController\nshowProjSubTab(tab)\n3 sub-tabs:\nCenarios / Analise / Simuladores" as PCTRL

  package "Sub-tab: Cenarios 2025-2050" {
    component "ScenarioCards\n🔴 BAU (tendencia)\n🟡 Moderado (ABC+/NDC)\n🟢 Embrapa (sistemas)\n🔵 Ideal (meta 2050)" as CARDS
    component "SeletorVariavel\nGEE / Desmat\nTemperatura / Seq. Carbono" as SEL_VAR
    component "Comparativo Cenarios\n2025-2050 (full width)\nLine multi-serie" as CH_MAIN
    component "Temperatura Projetada\npor Cenario (Line)" as CH_TEMP
    component "Desmatamento Projetado\nkm2/ano (Bar)" as CH_DESM
    component "Sequestro Carbono\nILPF+SAF Mt C (Area)" as CH_SEQ
    component "GEE Historico MA\n2000-2025 SEEG (Bar+Line)" as CH_HIST
    component "Resumo 2050 por Cenario\nGEE / Delta vs BAU\nDesmat / Temp / Seq" as TAB_2050
  }

  package "Sub-tab: Analise Comparativa Municipal" {
    component "AnaliseComparativaController\nbuildAnaliseHTML()\ninjetado em #proj-analise" as ANAL_CTRL
    component "SeletorMunicipios\nPesquisa multiplos\nmunicipios simultaneos" as MUN_SEL
    component "SeletorIndicadorGEE\nGEE / IDH / PIB\nPobreza / Fome / Desmat\nQueimadas / Lavoura / Pesca" as IND_SEL
    component "ClassificadorGEE\n🔴 Critico\n🟡 Atencao\n🟢 Adequado\nThresholds por indicador:\ngee_kt, desmat_km2,\nfome%, pob%, idh" as GEE_CLASS
    component "GraficoComparativo\nRadar + Bar por municipio" as CH_COMP
    component "TabelaRankingMunicipal\nRanking com badge de risco\npor indicador selecionado" as TAB_RANK
  }

  component "Sub-tab: Simuladores\n[ver diagrama L3d]" as SIM_LINK
}

PCTRL   --> CARDS      : "renderProjCharts()"
SEL_VAR --> CH_MAIN    : "onchange re-renderiza"
PCTRL   --> ANAL_CTRL  : "buildAnaliseHTML()"
IND_SEL --> GEE_CLASS  : "classifica MUNIC_DATA"
IND_SEL --> CH_COMP    : "atualiza grafico"
GEE_CLASS --> TAB_RANK : "badges de risco GEE"
@enduml


' ╔══════════════════════════════════════════════════════════════════════╗
' ║  C4 LEVEL 3d — SIMULADORES DE CENARIOS                            ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L3d_Simuladores
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #0d1a0d
skinparam defaultFontColor #d4f0d4
skinparam arrowColor #4ade80
skinparam arrowFontColor #86efac
skinparam componentBackgroundColor #1f3320
skinparam componentBorderColor #3a6a3a
skinparam componentFontColor #e8f5e8
skinparam packageBackgroundColor #0f1a0f
skinparam packageBorderColor #2a5a2a
skinparam packageFontColor #86efac
skinparam cloudBackgroundColor #1a1a2e
skinparam cloudBorderColor #6060a0
skinparam cloudFontColor #c0c0e0

title "DS Embrapa MA — C4 Level 3d: Simuladores de Cenarios"

cloud "Esri World Imagery\n(tiles satelite)" as ESRI

package "Sub-tab: Simuladores (#proj-simuladores)" {

  package "Simulador: Conversao de Areas Degradadas" {
    component "PainelParametros\n% area degradada MA\nSistema produtivo\nHorizonte temporal (anos)\nAtualiza automatico" as CONV_P
    component "MetricasConversao\n👷 Empregos\n💰 Renda anual\n💨 Sequestro CO2eq\n🌫 GEE evitado\n🌡 Reducao temp\n💸 Investimento" as CONV_M
    component "Trajetoria Temporal\n(Line Chart)" as CONV_T
    component "Comparativo Sistemas\n(Horiz. Bar Chart)" as CONV_C
    component "runConversaoSim()\nareaHa = pct/100 * 6.800.000ha\ntempRed = sys.temp_red * frac\ngeeEvit = areaHa * sys.seq_co2\nMA_DEGRADED_HA = 6.800.000ha" as RUN_CONV
  }

  package "Simulador: Plantio Agronomico" {

    component "PainelEsquerdo (sim-card)\nSistema (SA_SYSTEMS)\nVariante\nLayout (7 opcoes)\nSliders: Area / Espacamentos\nAngulo / Exportacao" as PLEFT

    package "Sub-aba: Vista Superior do Plantio" {
      component "Canvas 2D (#sa-canvas)\nHiDPI zoom/pan\nPlantas por especie" as CVS
      component "PainelMetricas\n🌱 Plantas / 📐 Densidade\n📊 Shannon-H / 💰 Renda\n💸 Invest / ⏱ Payback\n💨 Carbono / 🌫 GEE\n🌳 Cobertura / 👷 Empregos\n💧 Hidrico\n+ 🐝 Colmeias / 🐟 Tanques\n+ 🐓 Galinhas / 🐄 UA" as MET_P
      component "PainelAlertas\nEspacamento / Densidade\nArea / Cobertura copa\nLicenca ambiental" as ALERT
      component "GraficoComparativo\nRenda, carbono, empregos\npor variante (Horiz. Bar)" as COMP_CH
      component "PainelRecomendacoes\nrecomendacoes agronomicas\npor sistema e estado" as REC
      component "BotoesExportacao\nPNG / JPG / CSV" as EXP_BTN
    }

    package "Sub-aba: Projecao Satelite" {
      component "ControlesMapa\nPesquisa municipio (datalist)\nLat/Lng manuais\nBotao Ir para local" as SAT_CTRL
      component "MapaSatelite Leaflet\nEsri World Imagery\nWorld Boundaries overlay\nscrollWheelZoom ativo\nClique reposiciona centro" as SAT_MAP
      component "PlantOverlay (L.canvas)\nL.circleMarker por planta\npor speciesIdx / cor\nAte 2.500 plantas\nRaio adaptado ao zoom" as PLANT_OV
      component "PerimetroArea (drag)\n_saSatBoundary: L.polygon\n_saSatCornerMarkers: 4 alcas\ndrag -> resize ao vivo\ndragend -> runSimulation\nautoFit=true so na navegacao" as PERIM
      component "LegendaEspecies\nLeaflet Control bottomright\nicone + nome por especie\natualiza com o sistema" as LEGEND
    }

    component "Estado do Simulador\n_saState / _saPositions\n_saMetrics\narea, spacings, angle,\nlayout, system, variant" as STATE

    component "sa_onSlider() + debounce\n1. Atualiza _saState sincr.\n2. sa_calcMetricas() imediato\n3. sa_renderMetrics() imediato\n4. setTimeout(runSim, 280ms)" as SLIDER

    component "sa_runSimulation()\nSA_LAYOUTS[layout].generate()\n_saRotatePositions() se linear\nSa_calcMetricas()\nsa_drawPlantacao() ou\nsa_satDrawPlants()" as RUN_SIM
  }
}

CONV_P   --> RUN_CONV : "onchange slider"
RUN_CONV --> CONV_M   : "impactos"
RUN_CONV --> CONV_T   : "Chart.js"
RUN_CONV --> CONV_C   : "Chart.js"

PLEFT    --> SLIDER   : "eventos input"
SLIDER   --> STATE    : "atualiza sincrono"
SLIDER   --> MET_P    : "renderMetrics() imediato"
SLIDER   --> RUN_SIM  : "debounce 280ms"
RUN_SIM  --> CVS      : "sa_drawPlantacao()"
RUN_SIM  --> PLANT_OV : "sa_satDrawPlants()"
PERIM    --> RUN_SIM  : "dragend -> 100ms"
PERIM    --> MET_P    : "drag -> metricas ao vivo"
SAT_MAP  --> ESRI     : "Leaflet HTTPS"
@enduml


' ╔══════════════════════════════════════════════════════════════════════╗
' ║  C4 LEVEL 3e — CHAT IA                                             ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L3e_Chat_IA
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #0d1a0d
skinparam defaultFontColor #d4f0d4
skinparam arrowColor #4ade80
skinparam arrowFontColor #86efac
skinparam componentBackgroundColor #1f3320
skinparam componentBorderColor #3a6a3a
skinparam componentFontColor #e8f5e8

    component "Grafico: Distribuicao\npor Sistema (Bar)" as CH_SIS
    component "Grafico: Sistemas por\nMesorregiao (Bar)" as CH_REG
    component "Grafico: Implantacoes\npor Ano (Line)" as CH_ANO
    component "Grafico: Balanco\nde Carbono tCO2e (Bar)" as CH_CARB
    component "Grafico: Renda Media\nR$/mes por Sistema (Horiz. Bar)" as CH_RENDA
    component "Grafico: Area Total ha\npor Sistema (Doughnut)" as CH_AREA
    component "Casos de Referencia (URTs)\nILP, ILPF, SAF, Apic, Pisc,\nFrut, Roca, Sist, Extrat" as REF
  }

  package "Sub-tab: Indicadores do Estado (GEE e socioeconomicos)" {
    component "FiltrosEstado\nSeletor municipio\nSeletor indicador:\nGEE / IDH / PIB / Pobreza\nFome / Desmat / Queimadas\nPrecip / Temp / Lavoura" as FILT
    component "StatsEstado\nKPIs: media MA, max, min,\nmunicípio destacado" as STATS_E
    component "Indicador por Municipio\n217 municipios (full width)\nComparacao visual entre\ntodos os municipios do MA" as CH_MUN
    component "Top 10 Municipios\n(Horiz. Bar)" as CH_TOP
    component "Distribuicao por Bioma\nAmazonia / Cerrado / Transicao\n(Doughnut)" as CH_BIO
    component "IDH x PIB per capita\n(Scatter)" as CH_SCAT
    component "Cobertura Vegetal x GEE\n(Scatter)" as CH_VEG
    component "Tabela Municipios (217)\nBusca + filtro bioma/regiao\nColunas: pop, IDH, PIB,\npobreza, desmat, GEE,\nlavoura, bovinos, pesca" as TAB_MUN
    component "Exportador CSV\nexportData('munic')" as EXP_MUN
  }

  component "ChartMenu (tres pontos)\nPNG / JPG / CSV\npor grafico" as CMENU
}

OV_CTRL --> STATS    : "INITIAL_DATA"
OV_CTRL --> CH_SIS   : "Chart.js"
OV_CTRL --> CH_MUN   : "renderEstadoCharts()"
FILT    --> CH_MUN   : "onchange"
FILT    --> CH_TOP   : "filtra MUNIC_DATA"
FILT    --> STATS_E  : "atualiza KPIs"
CMENU   --> CH_SIS   : "exportacao"
@enduml



skinparam cloudBorderColor #6060a0
skinparam cloudFontColor #c0c0e0
skinparam databaseBackgroundColor #142014
skinparam databaseBorderColor #4ade80
skinparam databaseFontColor #e8f5e8

title "DS Embrapa MA — C4 Level 3e: Modulo Chat IA (Assistente Embrapa)"

cloud "Anthropic Claude API\nclaude-sonnet\nPOST /v1/messages" as CLAUDE
database "LocalStorage\n(api-key)" as LS_KEY

package "Modulo Chat IA (painel flutuante — canto inferior direito)" {

  component "ChatToggleButton\nicone 💬 fixo\nabre/fecha painel" as CHAT_BTN

  component "ChatPanel (#chat-panel)\n380px x 520px\nheader + mensagens\n+ setup + input" as PANEL

  component "ApiKeySetup\nInput Anthropic API key\nBotao Salvar -> localStorage\nVisivel quando sem chave" as API_SETUP

  component "ExemplosDeUso\n'Qual sistema para cerrado?'\n'Compare GEE municipios'\n'Layout para 5ha SAF?'\nClique -> envia automatico" as EXEMPLOS

  component "MessageHistory\n.chat-msg.user (direita)\n.chat-msg.assistant (esq)\n.chat-msg.sys-note (sistema)\nScroll suave para ultima" as HIST

  component "TypingIndicator\n3 pontos animados\nduante fetch -> some\nao receber resposta" as TYPING

  component "ContextBuilder\nbuildChatContext()\n- View ativa\n- Municipio filtrado\n- Sistema produtivo\n- Indicadores GEE MA\n- MUNIC_DATA selecionado\n- Instrucoes Embrapa" as CTX

  component "ClaudeApiClient\nfetch() POST HTTPS\nx-api-key + anthropic-version\n{model, messages, max_tokens}\nResponde: content[0].text" as API_CLI

  component "MessageRenderer\nFormata resposta Claude\nInsere .chat-msg.assistant\nTrata erros com msg amigavel" as MSG_R

  component "InputRow\nTextarea multi-linha\nEnter = envia\nShift+Enter = nova linha\nDesabilitado durante request" as INPUT
}

CHAT_BTN --> PANEL    : "toggle"
INPUT    --> CTX      : "buildChatContext()"
CTX      --> API_CLI  : "system prompt\n+ historico"
API_CLI  --> LS_KEY   : "le x-api-key"
API_CLI  --> CLAUDE   : "POST /v1/messages\nHTTPS / REST JSON"
CLAUDE   --> API_CLI  : "{content[{text}]}"
API_CLI  --> MSG_R    : "texto resposta"
API_CLI  --> TYPING   : "mostra -> oculta"
MSG_R    --> HIST     : "append .assistant"
INPUT    --> HIST     : "append .user"
EXEMPLOS --> INPUT    : "preenche + dispara"
API_SETUP --> LS_KEY  : "localStorage\n.setItem(key)"
@enduml



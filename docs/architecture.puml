' ╔══════════════════════════════════════════════════════════════════════╗
' ║  C4 LEVEL 1 — CONTEXTO DO SISTEMA                                  ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L1_Contexto_Sistema
!include <C4/C4_Context.puml>
LAYOUT_WITH_LEGEND()
title "DS Embrapa MA — C4 Level 1: Contexto do Sistema"

Person(usr_p, "Pesquisador / Tecnico\nEmbrapa (interno)", "Analisa indicadores de GEE,\nsistemas produtivos e projecoes\n2025-2050. Registra URTs.")
Person(usr_e, "Usuario Externo\n(agricultor / gestor)", "Agricultor, extensionista\nou gestor publico - consulta\nmapas, simula plantio e guias.")
Person(adm, "Administrador\nEmbrapa", "Cadastra e valida\nUnidades de Referencia\nTecnologica (URTs).")

System(ds, "DS Embrapa MA\n(Dashboard Cientifico)", "SPA estatica GitHub Pages.\nIndicadores socioambientais,\nGEE, mapa interativo,\nsimuladores e chat IA.")

System_Ext(bq, "Google BigQuery", "BD em nuvem: GEE (SEEG),\nPRODES, MapBiomas, IBGE.\n[integracao planejada]")
System_Ext(claude, "Anthropic Claude API", "LLM - respostas contextuais\nvia chat integrado.\nContexto: municipio + GEE.")
System_Ext(esri, "Esri ArcGIS Online", "Tiles de satelite para\nprojecao de plantio\nno terreno real (Leaflet).")
System_Ext(ibge, "IBGE / SEEG / PRODES\n/ MapBiomas", "Fontes compiladas em\nMUNIC_DATA (217 municipios)\ncom 22 indicadores cada.")
System_Ext(ls, "Browser LocalStorage", "Persistencia local dos\nregistros de URTs\n(chave: ds_embrapa_ma_v2).")

Rel(usr_p, ds, "Analisa, simula\ne registra", "HTTPS / Browser")
Rel(usr_e, ds, "Consulta e simula", "HTTPS / Browser")
Rel(adm, ds, "Cadastra URTs", "HTTPS / Browser")
Rel_D(ds, bq, "Consulta dados GEE\n[planejado]", "BigQuery REST API")
Rel_D(ds, claude, "Contexto + pergunta\n-> resposta IA", "fetch() / REST JSON")
Rel_D(ds, esri, "Tiles satelite\npara plantio", "HTTPS / Leaflet")
Rel_R(ds, ibge, "MUNIC_DATA embutido\nno bundle estatico", "JS estatico")
Rel_R(ds, ls, "Persiste e le\nregistros locais", "Web Storage API")
@enduml


' ╔══════════════════════════════════════════════════════════════════════╗
' ║  C4 LEVEL 2 — CONTAINERS                                           ║
' ╚══════════════════════════════════════════════════════════════════════╝
@startuml C4_L2_Containers
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #0d1a0d
skinparam defaultFontColor #d4f0d4
skinparam arrowColor #4ade80
skinparam arrowFontColor #86efac
skinparam rectangleBackgroundColor #1a2a1a
skinparam rectangleBorderColor #3a6a3a
skinparam rectangleFontColor #e8f5e8
skinparam packageBackgroundColor #0f1a0f
skinparam packageBorderColor #2a5a2a
skinparam packageFontColor #86efac
skinparam componentBackgroundColor #1f3320
skinparam componentBorderColor #3a6a3a
skinparam componentFontColor #e8f5e8
skinparam databaseBackgroundColor #142014
skinparam databaseBorderColor #4ade80
skinparam databaseFontColor #e8f5e8
skinparam cloudBackgroundColor #1a1a2e
skinparam cloudBorderColor #6060a0
skinparam cloudFontColor #c0c0e0
skinparam actorBackgroundColor #1a2a1a
skinparam actorBorderColor #4ade80
skinparam actorFontColor #e8f5e8
skinparam noteBorderColor #2a5a2a
skinparam noteBackgroundColor #0f1a0f
skinparam noteFontColor #86efac
skinparam legendBackgroundColor #0f1a0f
skinparam legendBorderColor #2a5a2a

title "DS Embrapa MA — C4 Level 2: Containers"

actor "Pesquisador\nEmbrapa" as USR
actor "Usuario\nExterno" as UEXT
actor "Administrador" as ADM

cloud "Google BigQuery\n[planejado]" as BQ
cloud "Anthropic\nClaude API" as CLAUDE
cloud "Esri ArcGIS\nOnline" as ESRI

package "DS Embrapa MA — GitHub Pages (SPA Estatica)" {
  component "Shell / Roteador\n(index.html)\n\nHTML5 + CSS3 + JS inline\nHeader nav (6 views), sidebar,\nchat flutuante, modal cadastro" as SHELL
  component "Dados Embutidos\n(INITIAL_DATA + MUNIC_DATA)\n\n217 municipios MA (IBGE 2024)\n22 indicadores por municipio\nRegistros URTs + GEE historico" as DATA
  component "Motor de Analise\n(proj-simuladores.js)\n\nComparacao Municipal\nClassificacao GEE\nConversao de Areas\nProjecoes 2025-2050" as PROJSIM
  component "Simulador de Plantio\n(simuladores/simulador.js)\n\nOrquestra Vista Canvas\ne Projecao Satelite\ndebounce + drag resize" as PLSIM
  component "Geradores de Layout\n(simuladores/layouts.js)\n\n7 algoritmos: linear, hexagonal,\ncircular, faixas, grid,\naleatório, mosaico" as LAY
  component "Motor de Metricas\n(simuladores/metricas.js)\n\nShannon-H, carbono, renda,\npayback, empregos, alertas\ne recomendacoes" as MET
  component "Renderizador Canvas\n(simuladores/visualizacao.js)\n\nHiDPI zoom/pan\nCanvas 2D por especie" as VIZ
  component "Catalogo de Sistemas\n(simuladores/dados_agricolas.js)\n\nSA_SYSTEMS: 10 sistemas\nVariantes, especies, cores\ne parametros agronomicos" as DADAG
  component "Modulo de Exportacao\n(simuladores/exportacao.js)\n\nPNG / JPG / CSV\ncom parametros e metricas" as EXP
  database "LocalStorage\n(ds_embrapa_ma_v2)" as LS
}

USR  --> SHELL : "navega"
UEXT --> SHELL : "consulta"
ADM  --> SHELL : "cadastra URTs"

SHELL  --> DATA   : "le INITIAL_DATA\ne MUNIC_DATA"
SHELL  --> PROJSIM : "analise e\nsimuladores"
SHELL  --> PLSIM   : "simulador\nde plantio"
PLSIM  --> LAY     : "SA_LAYOUTS[key]\n.generate()"
PLSIM  --> MET     : "sa_calcMetricas()"
PLSIM  --> VIZ     : "sa_drawPlantacao()"
PLSIM  --> DADAG   : "SA_SYSTEMS[key]"
PLSIM  --> EXP     : "sa_export*()"
PROJSIM --> DATA   : "MUNIC_DATA[]"
SHELL  --> LS      : "saveData()\nloadData()"

SHELL  ..> CLAUDE : "Chat: contexto\n+ pergunta -> IA"
PLSIM  ..> ESRI   : "tiles satelite\nLeaflet"
PROJSIM ..> BQ    : "[planejado]"
@enduml


